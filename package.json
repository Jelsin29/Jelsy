{
  "name": "jelsy",
  "version": "0.0.0",
  "type": "module",
  "description": "The modern, type-safe environment variable validator",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix --quiet . ; prettier --list-different --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --import tsx bench/parse.bench.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "release": "np"
  },
  "keywords": [
    "env",
    "environment",
    "variables",
    "validation",
    "type-safe",
    "typescript",
    "config",
    "configuration",
    "envsafe",
    "envalid"
  ],
  "author": "Jelsin29",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jelsin29/Jelsy.git"
  },
  "bugs": {
    "url": "https://github.com/Jelsin29/Jelsy/issues"
  },
  "homepage": "https://github.com/Jelsin29/Jelsy#readme",
  "np": {
    "yarn": false,
    "contents": "."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "expect-type": "^1.3.0",
    "globals": "^17.4.0",
    "np": "^11.0.2",
    "prettier": "^3.8.1",
    "tinybench": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
